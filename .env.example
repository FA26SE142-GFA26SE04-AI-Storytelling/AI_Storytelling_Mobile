# Copy thành .env rồi chạy: flutter run --dart-define-from-file=.env
# Bỏ trống hoặc không truyền file thì app gọi https://api.taletale.site/api/v1
#
# Backend local:
#   - Web (Chrome/Edge, phải chạy --web-port 3000 vì CORS) và Android cắm USB (sau khi chạy adb reverse tcp:5259 tcp:5259): http://localhost:5259
#   - Android emulator: http://10.0.2.2:5259
#   - Điện thoại cùng Wi-Fi: http://<IP LAN của máy tính>:5259
API_URL=http://localhost:5259
